{
  "manifest_version": 3,
  "name": "Local Job Tracker",
  "version": "0.1.0",
  "description": "A privacy-first local job application tracker.",
  "action": { "default_title": "Track job application", "default_popup": "index.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"]
}